else output is "FAIL: nonzero should be true"

output is "STRING TRUTHINESS"
empty_text is ""
filled_text is "LOIS"
if empty_text
then output is "FAIL: empty string should be false"
else output is "PASS: empty string is false"
if filled_text
then output is "PASS: nonempty string is true"
else output is "FAIL: nonempty string should be true"

output is "SET TRUTHINESS"
empty_set is {}
filled_set is {1}
if empty_set
then output is "FAIL: empty set should be false"
else output is "PASS: empty set is false"
if filled_set
then output is "PASS: nonempty set is true"
else output is "FAIL: nonempty set should be true"
