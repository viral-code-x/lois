then output is "PRIORITY_IF"
else if x == 20
then output is "PRIORITY_ELSE_IF"
but if x == 30
then output is "PRIORITY_BUT_IF"
else output is "PRIORITY_ELSE"


output is "=== TEST 11: ALL CONDITIONS FALSE ==="

