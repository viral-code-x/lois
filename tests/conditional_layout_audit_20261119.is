output is "=== TEST 9: MIXED ALTERNATIVE PRIORITY ==="

x is 30

if x == 10
then output is "MIXED_IF"
else if x >= 20
then output is "MIXED_ELSE_IF"
but if x == 30
then output is "MIXED_BUT_IF"
else output is "MIXED_ELSE"


output is "=== TEST 10: BUT IF AFTER FAILED ELSE IF ==="

